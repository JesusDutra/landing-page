# Copia este archivo a .env y completa tus valores
BINANCE_API_KEY=pega_aqui_tu_api_key
BINANCE_API_SECRET=pega_aqui_tu_api_secret

# Símbolo y polling
BINANCE_SYMBOL=BTCUSDT
BOT_POLL_SECONDS=2

# Regla de riesgo
BOT_TRIGGER_PCT=0.02
BOT_PARTIAL_CLOSE_PCT=0.80

# Seguridad
BOT_DRY_RUN=true

# Trailing opcional
BOT_TRAILING_ENABLED=true
BOT_TRAILING_GAP_PCT=0.005
BOT_TRAILING_STEP_PCT=0.0025
